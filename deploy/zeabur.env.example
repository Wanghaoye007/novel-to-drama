# Model provider. Keep secrets in Zeabur Variables, never in Git.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=bytedance-seed/seed-2.0-mini
OPENAI_TIMEOUT=300
OPENAI_MAX_TOKENS=20000
NOVEL_DRAMA_LLM_PROVIDER=openrouter
NOVEL_DRAMA_LLM_CALL_TIMEOUT_SECONDS=240
NOVEL_DRAMA_ENGINE_TIMEOUT_MS=1800000
NOVEL_DRAMA_ENGINE_TIMEOUT_RESUMES=1

# Internal operations access.
NOVEL_DRAMA_ACCESS_TOKEN=
NOVEL_DRAMA_SESSION_SECRET=
NOVEL_DRAMA_ACCESS_COOKIE_SECURE=1
NOVEL_DRAMA_ALLOW_SESSION_SWITCH=0
NOVEL_DRAMA_AUTH_MODE=shared_token
NOVEL_DRAMA_USER_EMAIL=ops@novel-drama.local
NOVEL_DRAMA_TENANT_SLUG=ops
NOVEL_DRAMA_TENANT_NAME=Operations Workspace

# Zeabur runtime. Attach one persistent Volume at /data.
NOVEL_DRAMA_PERSIST_ROOT=/data
NOVEL_DRAMA_DB_PATH=/data/db.sqlite
NOVEL_DRAMA_STORAGE_ROOT=/data/storage
NOVEL_DRAMA_BACKUP_DIR=/data/backups
NOVEL_DRAMA_BACKUP_RETENTION_DAYS=14
NOVEL_DRAMA_BACKUP_MAX_AGE_HOURS=48
NOVEL_DRAMA_BACKUP_INTERVAL_SECONDS=86400
NOVEL_DRAMA_JOB_POLL_MS=2000

# Production behavior.
NOVEL_DRAMA_ONLINE_MODE=1
NOVEL_DRAMA_DEPLOYMENT_TARGET=production
NOVEL_DRAMA_DEPLOYMENT_AUDIENCE=internal
NOVEL_DRAMA_WEB_MOCK=0
NOVEL_DRAMA_AUTO_WORKER=0
NOVEL_DRAMA_REQUIRE_API_KEY=0
NOVEL_DRAMA_REQUIRE_CREDITS=0
NOVEL_DRAMA_INTERNAL_PROJECT_LIMIT=500
NOVEL_DRAMA_INTERNAL_MONTHLY_JOB_LIMIT=5000
NOVEL_DRAMA_GENERATION_VARIANT=drama_engine_first
NOVEL_DRAMA_REPAIR_BUDGET=episode
